<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fisher.spring.mapper.UserMapper">
    <!--自定义分页查询-->
    <select id="selectPage" resultType="fisher.spring.entity.User">
        select * from user where age = #{age} and is_delete = 0
    </select>

</mapper>
